#!/bin/bash
#PBS -N conc_e4f1235_a3
#PBS -l select=1:ncpus=2:mem=16gb:ngpus=1:gpu_type=RTX6000
#PBS -l walltime=02:00:00
#PBS -J 0-19
#PBS -j oe
#PBS -o /rds/general/user/jh1125/home/Individual_Project/jobs/logs/

# E4 folds 1/2/3/5: A3 joint (no SSL) on KP, 4 folds × 5 seeds = 20 tasks.

set -e
cd $PBS_O_WORKDIR
module load Python/3.12.3-GCCcore-13.3.0
source .venv/bin/activate

FOLDS=(1 2 3 5)
IDX=$PBS_ARRAY_INDEX
FOLD_IDX=$(( IDX / 5 ))
SEED=$(( IDX % 5 ))
FOLD=${FOLDS[$FOLD_IDX]}

echo "[array $IDX] fold=loco${FOLD}  seed=$SEED"

python -m lacewing.quantification.methods.joint_cls_quant \
    --cache-stem "regress_conc_loco${FOLD}" \
    --arch a3 \
    --alpha 0.5 \
    --seed "$SEED" \
    --window 120 \
    --stride 10 \
    --k_consecutive 3 \
    --k_thr 0.7 \
    --epochs 30
