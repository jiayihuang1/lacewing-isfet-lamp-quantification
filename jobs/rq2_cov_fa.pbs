#!/bin/bash
#PBS -N p1_fa_sigma
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=02:30:00
#PBS -J 0-14
#PBS -j oe
#PBS -o /rds/general/user/jh1125/home/Individual_Project/jobs/logs/

set -e
cd $PBS_O_WORKDIR

# Activate venv (same pattern as p2_sweep.pbs)
module load Python/3.12.3-GCCcore-13.3.0
source .venv/bin/activate

# Config × seed grid: PBS_ARRAY_INDEX ∈ [0, 14] → (sigma, seed).
SIGMAS=(2 3 5 8 12)
SEEDS=(0 1 2)
IDX=$PBS_ARRAY_INDEX
SIGMA_IDX=$(( IDX / ${#SEEDS[@]} ))
SEED_IDX=$(( IDX % ${#SEEDS[@]} ))
SIGMA=${SIGMAS[$SIGMA_IDX]}
SEED=${SEEDS[$SEED_IDX]}

EXP="p1_fa_sigma${SIGMA}_wmse"
echo "[array $IDX] sigma=$SIGMA seed=$SEED  →  experiment=$EXP"

python -m lacewing.quantification.methods.pdf_regression \
    --experiment "$EXP" \
    --sigma "$SIGMA" \
    --seed "$SEED" \
    --epochs 40 \
    --loss wmse
