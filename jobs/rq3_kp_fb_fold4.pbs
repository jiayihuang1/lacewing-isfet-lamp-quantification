#!/bin/bash
#PBS -N conc_e2f4_fb
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=03:00:00
#PBS -J 0-4
#PBS -j oe
#PBS -o /rds/general/user/jh1125/home/Individual_Project/jobs/logs/

# E2 fold-4-only: F-B U-Net on KP, single fixed test chip (chip 4).
# 5 seeds, matches CoV protocol structure (single fixed test chip).

set -e
cd $PBS_O_WORKDIR
module load Python/3.12.3-GCCcore-13.3.0
source .venv/bin/activate

SEED=$PBS_ARRAY_INDEX
FOLD=4

echo "[array $PBS_ARRAY_INDEX] fold=loco${FOLD}  seed=$SEED"

python -m lacewing.quantification.methods.sliding_window_cls \
    --cache-stem "regress_conc_loco${FOLD}" \
    --seed "$SEED" \
    --window 120 \
    --stride 10 \
    --backbone unet \
    --k_consecutive 3 \
    --k_thr 0.7 \
    --epochs 30
