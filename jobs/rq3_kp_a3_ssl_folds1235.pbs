#!/bin/bash
#PBS -N conc_e7f1235_a3_ssl
#PBS -l select=1:ncpus=2:mem=16gb:ngpus=1:gpu_type=RTX6000
#PBS -l walltime=02:00:00
#PBS -J 0-19
#PBS -j oe
#PBS -o /rds/general/user/jh1125/home/Individual_Project/jobs/logs/

# E7 folds 1/2/3/5: A3 joint + contrastive SSL 100-ep (CoV secondary recipe) on KP.

set -e
cd $PBS_O_WORKDIR
module load Python/3.12.3-GCCcore-13.3.0
source .venv/bin/activate

FOLDS=(1 2 3 5)
IDX=$PBS_ARRAY_INDEX
FOLD_IDX=$(( IDX / 5 ))
SEED=$(( IDX % 5 ))
FOLD=${FOLDS[$FOLD_IDX]}

ENCODER_PATH="Analysis/quantification/methods/results/p4_ssl_contrastive_unet_conc_ep100/pretrained.pt"
if [ ! -f "$ENCODER_PATH" ]; then
    echo "ERROR: pretrained encoder not found at $ENCODER_PATH"
    exit 1
fi

echo "[array $IDX] arch=a3 fold=loco${FOLD} seed=$SEED encoder=$ENCODER_PATH"

python -m lacewing.quantification.methods.joint_cls_quant \
    --cache-stem "regress_conc_loco${FOLD}" \
    --arch a3 \
    --alpha 0.5 \
    --seed "$SEED" \
    --window 120 \
    --stride 10 \
    --k_consecutive 3 \
    --k_thr 0.7 \
    --epochs 30 \
    --pretrained-encoder "$ENCODER_PATH"
