#!/bin/bash
#PBS -N conc_e1_rq1
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=02:30:00
#PBS -J 0-199
#PBS -j oe
#PBS -o /rds/general/user/jh1125/home/Individual_Project/jobs/logs/

# E1: RQ1 classifier arch sweep on KP-conc data (all 5 chips) with
# COV-NTC augmentation for class balance.
#
# 8 architectures × 5 LOCO folds × 5 seeds = 200 tasks.
#
# Each fold holds out one KP-conc chip as test; train pool = the other
# 4 KP chips + all COV NTC pixels (~30 COV chips, ~41k negatives) from
# the shared dataset_conc classification cache.

set -e
cd $PBS_O_WORKDIR
module load Python/3.12.3-GCCcore-13.3.0
source .venv/bin/activate

MODELS=("ann" "fcn" "resnet" "inception" "gru" "transformer_patch" "cnn_gru_par" "cnn_transformer_seq")
SEEDS=(0 1 2 3 4)
FOLDS=(
    "conc_260812_KP_01"
    "conc_260813_KP_DDM_02"
    "conc_260820_KP_DDM_03"
    "conc_260823_KP_DDM_04"
    "conc_260827_KP_DDM_05"
)

IDX=$PBS_ARRAY_INDEX
MODEL_IDX=$(( IDX / 25 ))                    # 5 folds × 5 seeds = 25 per model
FOLD_SEED_IDX=$(( IDX % 25 ))
FOLD_IDX=$(( FOLD_SEED_IDX / 5 ))
SEED_IDX=$(( FOLD_SEED_IDX % 5 ))

MODEL=${MODELS[$MODEL_IDX]}
FOLD=${FOLDS[$FOLD_IDX]}
SEED=${SEEDS[$SEED_IDX]}

echo "[array $IDX] model=$MODEL  fold=$FOLD  seed=$SEED"

python -m lacewing.classification.core.train \
    --experiment "conc_loco_${FOLD}" \
    --cache dataset_conc \
    --split chip \
    --fold "$FOLD" \
    --model "$MODEL" \
    --seed "$SEED" \
    --epochs 40
